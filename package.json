{
  "name": "fidelity-mm",
  "version": "1.0.0",
  "devDependencies": {
    "@farmfe/cli": "^1.0.5",
    "@farmfe/core": "^1.7.11",
    "@farmfe/plugin-react": "^1.2.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.3.14",
    "postcss": "^8.5.19",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "private": true,
  "scripts": {
    "dev": "bun --bun src/scripts/dev.mjs",
    "build": "bunx --bun tailwindcss -i ./src/styles/styles.css -o ./src/styles/tailwind.generated.css && bunx --bun farm build",
    "preview": "bunx --bun farm preview",
    "scrape:fidelity": "bun src/scripts/fidelity/scrape-fidelity-mm.ts",
    "scrape:fidelity-minimums": "bun src/scripts/fidelity/scrape-fidelity-mm-minimums.ts",
    "scrape:fidelity-tax": "bun src/scripts/fidelity/scrape-fidelity-mm-tax.ts",
    "validate:data": "bun src/scripts/fidelity/validate-fidelity-data.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "playwright test"
  },
  "type": "module",
  "dependencies": {
    "preact": "^10.29.7"
  }
}
